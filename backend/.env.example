GEMINI_API_KEY=replace_with_your_gemini_api_key
# Opt in only after approving live API usage. Default is rule-based, no calls.
GEMINI_ENABLED=false
# No default model: select a model available to your AI Studio key.
GEMINI_MODEL=

# Generate a unique random secret (at least 32 characters) for demo sessions.
DEMO_SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-chars
