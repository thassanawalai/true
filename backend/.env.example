GEMINI_API_KEY=replace_with_your_gemini_api_key
# Opt in only after approving live API usage. Default is rule-based, no calls.
GEMINI_ENABLED=false
# No default model: select a model available to your AI Studio key.
GEMINI_MODEL=

# Generate a unique random secret (at least 32 characters) for demo sessions.
DEMO_SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-chars

# Set password mode for a protected demo. It is mandatory when Gemini is enabled.
# Use unique random passwords of at least 16 characters per seeded email.
DEMO_AUTH_MODE=mock
DEMO_LOGIN_PASSWORDS_JSON={}

# Single-process request limits shared by ticket and chat inference.
GEMINI_USER_PER_MINUTE=12
GEMINI_GLOBAL_PER_MINUTE=60
GEMINI_MAX_CALLS_PER_DAY=250

# Optional local Chroma index containing only approved synthetic playbooks.
DEMO_KB_CHROMA_ENABLED=false
